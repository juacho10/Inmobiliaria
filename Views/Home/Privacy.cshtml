@{
    ViewData["Title"] = "Política de Privacidad";
    Layout = "_Layout";
}

<div class="container">
    <h1>@ViewData["Title"]</h1>
    
    <div class="row mt-4">
        <div class="col-md-8">
            <div class="card">
                <div class="card-body">
                    <h3>Política de Privacidad de Inmobiliaria</h3>
                    <p class="text-muted">Última actualización: @DateTime.Now.ToString("dd/MM/yyyy")</p>
                    
                    <h5>Recopilación de Información</h5>
                    <p>Recopilamos información personal que usted nos proporciona directamente cuando:</p>
                    <ul>
                        <li>Registra propiedades en nuestro sistema</li>
                        <li>Gestiona contratos de alquiler</li>
                        <li>Realiza pagos a través de la plataforma</li>
                        <li>Se comunica con nuestro servicio al cliente</li>
                    </ul>

                    <h5>Uso de la Información</h5>
                    <p>Utilizamos la información recopilada para:</p>
                    <ul>
                        <li>Gestionar propiedades y contratos</li>
                        <li>Procesar pagos y transacciones</li>
                        <li>Proveer soporte al cliente</li>
                        <li>Mejorar nuestros servicios</li>
                        <li>Cumplir con obligaciones legales</li>
                    </ul>

                    <h5>Protección de Datos</h5>
                    <p>Implementamos medidas de seguridad técnicas y organizativas para proteger su información personal contra accesos no autorizados, alteración, divulgación o destrucción.</p>

                    <h5>Compartición de Información</h5>
                    <p>No vendemos, comerciamos ni transferimos su información personal a terceros, excepto cuando sea necesario para:</p>
                    <ul>
                        <li>Cumplir con requisitos legales</li>
                        <li>Proteger nuestros derechos y seguridad</li>
                        <li>Procesar pagos a través de proveedores autorizados</li>
                    </ul>

                    <h5>Sus Derechos</h5>
                    <p>Usted tiene derecho a:</p>
                    <ul>
                        <li>Acceder a su información personal</li>
                        <li>Corregir información inexacta</li>
                        <li>Solicitar la eliminación de sus datos</li>
                        <li>Oponerse al procesamiento de sus datos</li>
                    </ul>

                    <div class="alert alert-info mt-4">
                        <strong>Contacto:</strong> Para ejercer sus derechos o consultas sobre privacidad, contáctenos en: 
                        <a href="mailto:privacidad@inmobiliaria.com">privacidad@inmobiliaria.com</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>