@{
    ViewData["Title"] = "Página Super Privada";
    Layout = "_Layout";
}

<div class="container mt-4">
    <div class="alert alert-warning">
        <h4>🔒 ¡Página Super Privada!</h4>
        <p>Esta página solo es accesible para usuarios con rol de Administrador.</p>
    </div>
    
    <div class="card">
        <div class="card-header">
            <h5>Información de Administrador</h5>
        </div>
        <div class="card-body">
            <p><strong>Nombre:</strong> @User.Identity.Name</p>
            <p><strong>Es Administrador:</strong> @User.IsInRole("Administrador")</p>
            <p><strong>Rol:</strong> @User.Claims.FirstOrDefault(c => c.Type == System.Security.Claims.ClaimTypes.Role)?.Value</p>
        </div>
    </div>
</div>