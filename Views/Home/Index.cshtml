@{
    ViewData["Title"] = "Inicio - Inmobiliaria";
    Layout = "_Layout";
}

<div class="container mt-4">
    <div class="text-center mb-5">
        <h1 class="display-4 text-primary">Sistema de Gestión Inmobiliaria</h1>
        <p class="lead text-muted">Administración integral de Propietarios, Inquilinos y Propiedades</p>
    </div>
    
    <div class="row mt-5">
        <div class="col-md-4 mb-4">
            <div class="card dashboard-card h-100">
                <div class="card-body text-center">
                    <div class="mb-3">
                        <i class="fas fa-user-tie fa-3x text-primary"></i>
                    </div>
                    <h5 class="card-title">🏠 Propietarios</h5>
                    <p class="card-text">Gestione propietarios y sus propiedades de manera eficiente</p>
                    <a href="@Url.Action("Index", "Propietarios")" class="btn btn-primary btn-lg w-100">Ver Propietarios</a>
                </div>
            </div>
        </div>
        
        <div class="col-md-4 mb-4">
            <div class="card dashboard-card h-100">
                <div class="card-body text-center">
                    <div class="mb-3">
                        <i class="fas fa-users fa-3x text-success"></i>
                    </div>
                    <h5 class="card-title">👥 Inquilinos</h5>
                    <p class="card-text">Administre inquilinos y sus contratos de alquiler</p>
                    <a href="@Url.Action("Index", "Inquilinos")" class="btn btn-success btn-lg w-100">Ver Inquilinos</a>
                </div>
            </div>
        </div>
        
        <div class="col-md-4 mb-4">
            <div class="card dashboard-card h-100">
                <div class="card-body text-center">
                    <div class="mb-3">
                        <i class="fas fa-info-circle fa-3x text-info"></i>
                    </div>
                    <h5 class="card-title">📋 Información</h5>
                    <p class="card-text">Políticas de privacidad y términos del servicio</p>
                    <a href="@Url.Action("Privacy", "Home")" class="btn btn-info btn-lg w-100">Privacidad</a>
                </div>
            </div>
        </div>
    </div>

    <!-- Estadísticas rápidas -->
    <div class="row mt-5">
        <div class="col-12">
            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0">Resumen del Sistema</h5>
                </div>
                <div class="card-body">
                    <div class="row text-center">
                        <div class="col-md-3">
                            <h3 class="text-primary" id="contadorPropietarios">0</h3>
                            <p class="text-muted">Propietarios Registrados</p>
                        </div>
                        <div class="col-md-3">
                            <h3 class="text-success" id="contadorInquilinos">0</h3>
                            <p class="text-muted">Inquilinos Activos</p>
                        </div>
                        <div class="col-md-3">
                            <h3 class="text-warning" id="contadorContratos">0</h3>
                            <p class="text-muted">Contratos Vigentes</p>
                        </div>
                        <div class="col-md-3">
                            <h3 class="text-info" id="contadorPagos">0</h3>
                            <p class="text-muted">Pagos Procesados</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://kit.fontawesome.com/your-fontawesome-kit.js" crossorigin="anonymous"></script>
    <script>
        // Animación de contadores (simulada para la demo)
        document.addEventListener('DOMContentLoaded', function() {
            function animarContador(elemento, valorFinal, duracion = 2000) {
                let valorInicial = 0;
                const incremento = valorFinal / (duracion / 16);
                const contador = elemento;
                
                function actualizarContador() {
                    valorInicial += incremento;
                    if (valorInicial < valorFinal) {
                        contador.textContent = Math.floor(valorInicial);
                        setTimeout(actualizarContador, 16);
                    } else {
                        contador.textContent = valorFinal;
                    }
                }
                actualizarContador();
            }

            // Simular datos (en una aplicación real estos vendrían del servidor)
            animarContador(document.getElementById('contadorPropietarios'), 24);
            animarContador(document.getElementById('contadorInquilinos'), 18);
            animarContador(document.getElementById('contadorContratos'), 12);
            animarContador(document.getElementById('contadorPagos'), 156);
        });
    </script>
}