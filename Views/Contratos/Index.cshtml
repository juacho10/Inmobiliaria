@model IEnumerable<Inmobiliaria.Models.Contrato>

@{
    ViewData["Title"] = "Contratos de Alquiler";
}

<h1>📄 Contratos de Alquiler</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">➕ Crear Nuevo Contrato</a>
</p>

<!-- Filtros de búsqueda -->
<form method="get" class="mb-4">
    <div class="row">
        <div class="col-md-6">
            <div class="input-group">
                <input type="text" name="search" class="form-control" placeholder="Buscar por dirección o inquilino..." value="@ViewBag.Search">
                <button type="submit" class="btn btn-outline-primary">🔍 Buscar</button>
            </div>
        </div>
        <div class="col-md-3">
            <select name="vigente" class="form-select" onchange="this.form.submit()">
                <option value="">Todos los estados</option>
                <option value="true" selected="@(ViewBag.Vigente == true)">Vigentes</option>
                <option value="false" selected="@(ViewBag.Vigente == false)">No Vigentes</option>
            </select>
        </div>
        <div class="col-md-3">
            <a href="@Url.Action("Index")" class="btn btn-outline-secondary">🔄 Limpiar</a>
        </div>
    </div>
</form>

@if (!Model.Any())
{
    <div class="alert alert-info">
        <strong>No se encontraron contratos.</strong>
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-hover">
            <thead class="table-dark">
                <tr>
                    <th>Inmueble</th>
                    <th>Inquilino</th>
                    <th>Fecha Inicio</th>
                    <th>Fecha Fin</th>
                    <th>Monto</th>
                    <th>Estado</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>
                            @if (item.Inmueble != null)
                            {
                                @item.Inmueble.Direccion
                            }
                            else
                            {
                                <span class="text-muted">No asignado</span>
                            }
                        </td>
                        <td>
                            @if (item.Inquilino != null)
                            {
                                @item.Inquilino.NombreCompleto
                            }
                            else
                            {
                                <span class="text-muted">No asignado</span>
                            }
                        </td>
                        <td>@item.FechaInicio.ToString("dd/MM/yyyy")</td>
                        <td>@item.FechaFin.ToString("dd/MM/yyyy")</td>
                        <td>$@item.Monto</td>
                        <td>
                            @if (item.Vigente)
                            {
                                <span class="badge bg-success">Vigente</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Finalizado</span>
                            }
                        </td>
                        <td>
                            <div class="btn-group" role="group">
                                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info" title="Detalles">👁️</a>
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning" title="Editar">✏️</a>
                                @if (item.Vigente)
                                {
                                    <a asp-action="Renovar" asp-route-id="@item.Id" class="btn btn-sm btn-success" title="Renovar">🔄</a>
                                }
                                @if (User.IsInRole("Administrador"))
                                {
                                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger" title="Eliminar">🗑️</a>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- Paginación -->
    @if (ViewBag.TotalPaginas > 1)
    {
        <nav aria-label="Paginación de contratos">
            <ul class="pagination justify-content-center">
                @for (int i = 1; i <= ViewBag.TotalPaginas; i++)
                {
                    <li class="page-item @(i == ViewBag.PaginaActual ? "active" : "")">
                        <a class="page-link" href="@Url.Action("Index", new { pagina = i, search = ViewBag.Search, vigente = ViewBag.Vigente })">@i</a>
                    </li>
                }
            </ul>
        </nav>
    }
}