@model Inmobiliaria.Models.Contrato

@{
    ViewData["Title"] = "Crear Contrato";
}

<div class="container">
    <div class="row">
        <div class="col-12">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a asp-action="Index">Contratos</a></li>
                    <li class="breadcrumb-item active">Crear Nuevo Contrato</li>
                </ol>
            </nav>
        </div>
    </div>

    <div class="row">
        <div class="col-md-8">
            <div class="card">
                <div class="card-header bg-primary text-white">
                    <h2 class="card-title mb-0">📄 Crear Nuevo Contrato de Alquiler</h2>
                </div>
                <div class="card-body">
                    <form asp-action="Create" id="contratoForm">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group mb-3">
                                    <label asp-for="InmuebleId" class="form-label fw-bold">🏠 Inmueble *</label>
                                    <select asp-for="InmuebleId" class="form-select" id="inmuebleSelect">
                                        @if (Model?.Inmueble != null)
                                        {
                                            <option value="@Model.Inmueble.Id" selected>
                                                @Model.Inmueble.Direccion - $@Model.Inmueble.Precio
                                            </option>
                                        }
                                    </select>
                                    <span asp-validation-for="InmuebleId" class="text-danger small"></span>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="form-group mb-3">
                                    <label asp-for="InquilinoId" class="form-label fw-bold">👤 Inquilino *</label>
                                    <select asp-for="InquilinoId" class="form-select" id="inquilinoSelect">
                                        @if (Model?.Inquilino != null)
                                        {
                                            <option value="@Model.Inquilino.Id" selected>
                                                @Model.Inquilino.NombreCompleto - DNI @Model.Inquilino.Dni
                                            </option>
                                        }
                                    </select>
                                    <span asp-validation-for="InquilinoId" class="text-danger small"></span>
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group mb-3">
                                    <label asp-for="FechaInicio" class="form-label fw-bold">📅 Fecha de Inicio *</label>
                                    <input asp-for="FechaInicio" type="date" class="form-control" id="fechaInicio" required />
                                    <span asp-validation-for="FechaInicio" class="text-danger small"></span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group mb-3">
                                    <label asp-for="FechaFin" class="form-label fw-bold">📅 Fecha de Fin *</label>
                                    <input asp-for="FechaFin" type="date" class="form-control" id="fechaFin" required />
                                    <span asp-validation-for="FechaFin" class="text-danger small"></span>
                                </div>
                            </div>
                        </div>

                        <div class="form-group mb-3">
                            <label asp-for="Monto" class="form-label fw-bold">💰 Monto Mensual *</label>
                            <div class="input-group">
                                <span class="input-group-text">$</span>
                                <input asp-for="Monto" type="number" class="form-control" step="0.01" min="1" required />
                            </div>
                            <span asp-validation-for="Monto" class="text-danger small"></span>
                        </div>

                        <div class="form-group form-check mb-3">
                            <input asp-for="Vigente" class="form-check-input" checked />
                            <label asp-for="Vigente" class="form-check-label fw-bold">Contrato Vigente</label>
                        </div>

                        <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                            <button type="submit" class="btn btn-success btn-lg">
                                <i class="fas fa-save"></i> Crear Contrato
                            </button>
                            <a asp-action="Index" class="btn btn-secondary btn-lg">Cancelar</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card">
                <div class="card-header bg-info text-white">
                    <h5 class="card-title mb-0">💡 Ayuda</h5>
                </div>
                <div class="card-body">
                    <p class="small">Los combos buscan en el servidor. Escribí para filtrar y desplazate para paginar.</p>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        $(function () {
            initSelect2('#inmuebleSelect',
                '@Url.Action("BuscarInmueblesDisponibles", "Contratos")',
                'Buscar inmueble por dirección o tipo...');

            initSelect2('#inquilinoSelect',
                '@Url.Action("BuscarInquilinos", "Contratos")',
                'Buscar inquilino por nombre o DNI...');
        });
    </script>
}