@model IEnumerable<Inmobiliaria.Models.Pago>

@{
    ViewData["Title"] = "Pagos";
    var contratoId = ViewBag.ContratoId as int?;
}

<h1>💰 Pagos</h1>

@if (contratoId.HasValue)
{
    <div class="alert alert-info">
        <i class="fas fa-filter"></i> Mostrando pagos del contrato <strong>#@contratoId</strong>
        <a asp-action="Index" class="btn btn-sm btn-outline-secondary ms-2">Ver todos los pagos</a>
    </div>
}

<p>
    @if (contratoId.HasValue)
    {
        <a asp-action="Create" asp-route-contratoId="@contratoId" class="btn btn-primary">
            ➕ Cargar Nuevo Pago a este Contrato
        </a>
    }
    else
    {
        <a asp-action="Create" class="btn btn-primary">➕ Cargar Nuevo Pago</a>
    }
</p>

<!-- Filtros -->
<form method="get" class="mb-4">
    <input type="hidden" name="contratoId" value="@contratoId" />
    <div class="row">
        <div class="col-md-6">
            <div class="input-group">
                <input type="text" name="search" class="form-control" placeholder="Buscar por concepto..." value="@ViewBag.Search">
                <button type="submit" class="btn btn-outline-primary">🔍 Buscar</button>
            </div>
        </div>
        <div class="col-md-3">
            <select name="anulado" class="form-select" onchange="this.form.submit()">
                <option value="">Todos los estados</option>
                <option value="false" selected="@(ViewBag.Anulado == false)">Activos</option>
                <option value="true" selected="@(ViewBag.Anulado == true)">Anulados</option>
            </select>
        </div>
        <div class="col-md-3">
            <a href="@Url.Action("Index")" class="btn btn-outline-secondary">🔄 Limpiar</a>
        </div>
    </div>
</form>

@if (!Model.Any())
{
    <div class="alert alert-info"><strong>No se encontraron pagos.</strong></div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-hover">
            <thead class="table-dark">
                <tr>
                    <th>#</th>
                    <th>Contrato</th>
                    <th>Fecha</th>
                    <th>Concepto</th>
                    <th>Importe</th>
                    <th>Estado</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr class="@(item.Anulado ? "table-secondary" : "")">
                        <td>@item.NumeroPago</td>
                        <td>#@item.ContratoId</td>
                        <td>@item.FechaPago.ToString("dd/MM/yyyy")</td>
                        <td>@item.Concepto</td>
                        <td>$@item.Importe.ToString("0.00")</td>
                        <td>
                            @if (item.Anulado)
                            {
                                <span class="badge bg-danger">Anulado</span>
                            }
                            else
                            {
                                <span class="badge bg-success">Activo</span>
                            }
                        </td>
                        <td>
                            <div class="btn-group" role="group">
                                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info" title="Detalles">👁️</a>
                                @if (!item.Anulado)
                                {
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning" title="Editar concepto">✏️</a>
                                    @if (User.IsInRole("Administrador"))
                                    {
                                        <a asp-action="Anular" asp-route-id="@item.Id" class="btn btn-sm btn-danger" title="Anular">🚫</a>
                                    }
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- Paginación -->
    @if (ViewBag.TotalPaginas > 1)
    {
        <nav>
            <ul class="pagination justify-content-center">
                @for (int i = 1; i <= ViewBag.TotalPaginas; i++)
                {
                    <li class="page-item @(i == ViewBag.PaginaActual ? "active" : "")">
                        <a class="page-link" href="@Url.Action("Index", new { pagina = i, contratoId = ViewBag.ContratoId, search = ViewBag.Search, anulado = ViewBag.Anulado })">@i</a>
                    </li>
                }
            </ul>
        </nav>
    }
}