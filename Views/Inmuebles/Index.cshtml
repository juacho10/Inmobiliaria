@model IEnumerable<Inmobiliaria.Models.Inmueble>

@{
    ViewData["Title"] = "Inmuebles";
}

<h1>🏠 Inmuebles</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">➕ Crear Nuevo Inmueble</a>
</p>

<!-- Filtros de búsqueda -->
<form method="get" class="mb-4">
    <div class="row">
        <div class="col-md-6">
            <div class="input-group">
                <input type="text" name="search" class="form-control" placeholder="Buscar por dirección, tipo o propietario..." value="@ViewBag.Search">
                <button type="submit" class="btn btn-outline-primary">🔍 Buscar</button>
            </div>
        </div>
        <div class="col-md-3">
            <select name="disponible" class="form-select" onchange="this.form.submit()">
                <option value="">Todos los estados</option>
                <option value="true" selected="@(ViewBag.Disponible == true)">Disponible</option>
                <option value="false" selected="@(ViewBag.Disponible == false)">No Disponible</option>
            </select>
        </div>
        <div class="col-md-3">
            <a href="@Url.Action("Index")" class="btn btn-outline-secondary">🔄 Limpiar</a>
        </div>
    </div>
</form>

@if (!Model.Any())
{
    <div class="alert alert-info">
        <strong>No se encontraron inmuebles.</strong>
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-hover">
            <thead class="table-dark">
                <tr>
                    <th>Dirección</th>
                    <th>Tipo</th>
                    <th>Uso</th>
                    <th>Ambientes</th>
                    <th>Precio</th>
                    <th>Propietario</th>
                    <th>Estado</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@Html.DisplayFor(modelItem => item.Direccion)</td>
                        <td>@Html.DisplayFor(modelItem => item.Tipo)</td>
                        <td>@Html.DisplayFor(modelItem => item.Uso)</td>
                        <td>@Html.DisplayFor(modelItem => item.Ambientes)</td>
                        <td>$@Html.DisplayFor(modelItem => item.Precio)</td>
                        <td>
                            @if (item.Propietario != null)
                            {
                                @item.Propietario.NombreCompleto
                            }
                            else
                            {
                                <span class="text-muted">No asignado</span>
                            }
                        </td>
                        <td>
                            @if (item.Disponible)
                            {
                                <span class="badge bg-success">Disponible</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">No Disponible</span>
                            }
                        </td>
                        <td>
                            <div class="btn-group" role="group">
                                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info" title="Detalles">👁️</a>
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning" title="Editar">✏️</a>
                                @if (User.IsInRole("Administrador"))
                                {
                                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger" title="Eliminar">🗑️</a>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- Paginación -->
    @if (ViewBag.TotalPaginas > 1)
    {
        <nav aria-label="Paginación de inmuebles">
            <ul class="pagination justify-content-center">
                @for (int i = 1; i <= ViewBag.TotalPaginas; i++)
                {
                    <li class="page-item @(i == ViewBag.PaginaActual ? "active" : "")">
                        <a class="page-link" href="@Url.Action("Index", new { pagina = i, search = ViewBag.Search, disponible = ViewBag.Disponible })">@i</a>
                    </li>
                }
            </ul>
        </nav>
    }
}