@model Inmobiliaria.Models.Inmueble

@{
    ViewData["Title"] = "Eliminar Inmueble";
}

<div class="container">
    <div class="row">
        <div class="col-12">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a asp-action="Index" asp-controller="Inmuebles">Inmuebles</a></li>
                    <li class="breadcrumb-item"><a asp-action="Details" asp-route-id="@Model.Id">@Model.Direccion</a></li>
                    <li class="breadcrumb-item active">Eliminar Inmueble</li>
                </ol>
            </nav>
        </div>
    </div>

    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card border-danger">
                <div class="card-header bg-danger text-white">
                    <h2 class="card-title mb-0">
                        <i class="fas fa-exclamation-triangle"></i> Eliminar Inmueble
                    </h2>
                </div>
                <div class="card-body">
                    <!-- Alerta de advertencia -->
                    <div class="alert alert-danger">
                        <h4 class="alert-heading">
                            <i class="fas fa-skull-crossbones"></i> ¡ADVERTENCIA!
                        </h4>
                        <p class="mb-0">
                            Está a punto de eliminar permanentemente un inmueble del sistema. 
                            Esta acción <strong>NO SE PUEDE DESHACER</strong>.
                        </p>
                    </div>

                    <!-- Información del Inmueble -->
                    <div class="card mb-4">
                        <div class="card-header bg-warning text-dark">
                            <h5 class="card-title mb-0">
                                <i class="fas fa-building"></i> Información del Inmueble a Eliminar
                            </h5>
                        </div>
                        <div class="card-body">
                            <dl class="row">
                                <dt class="col-sm-4">ID:</dt>
                                <dd class="col-sm-8">@Model.Id</dd>

                                <dt class="col-sm-4">Dirección:</dt>
                                <dd class="col-sm-8">@Model.Direccion</dd>

                                <dt class="col-sm-4">Tipo:</dt>
                                <dd class="col-sm-8">@Model.Tipo</dd>

                                <dt class="col-sm-4">Uso:</dt>
                                <dd class="col-sm-8">
                                    <span class="badge @(Model.Uso == "Comercial" ? "bg-info" : "bg-success")">
                                        @Model.Uso
                                    </span>
                                </dd>

                                <dt class="col-sm-4">Ambientes:</dt>
                                <dd class="col-sm-8">@Model.Ambientes</dd>

                                <dt class="col-sm-4">Precio:</dt>
                                <dd class="col-sm-8">$@Model.Precio.ToString("0.00")</dd>

                                <dt class="col-sm-4">Propietario:</dt>
                                <dd class="col-sm-8">
                                    @if (Model.Propietario != null)
                                    {
                                        @Model.Propietario.NombreCompleto
                                    }
                                    else
                                    {
                                        <span class="text-muted">No asignado</span>
                                    }
                                </dd>

                                <dt class="col-sm-4">Estado:</dt>
                                <dd class="col-sm-8">
                                    @if (Model.Disponible)
                                    {
                                        <span class="badge bg-success">Disponible</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">No Disponible</span>
                                    }
                                </dd>

                                <dt class="col-sm-4">Fecha Creación:</dt>
                                <dd class="col-sm-8">@Model.FechaCreacion.ToString("dd/MM/yyyy HH:mm")</dd>
                            </dl>
                        </div>
                    </div>

                    <!-- Verificación de Impacto -->
                    <div class="card border-warning">
                        <div class="card-header bg-warning text-dark">
                            <h5 class="card-title mb-0">
                                <i class="fas fa-exclamation-circle"></i> Impacto de la Eliminación
                            </h5>
                        </div>
                        <div class="card-body">
                            <div class="alert alert-warning">
                                <h6>
                                    <i class="fas fa-radiation"></i> Esta acción afectará:
                                </h6>
                                <ul class="mb-0">
                                    <li>Contratos activos asociados a este inmueble</li>
                                    <li>Historial de pagos relacionados</li>
                                    <li>Reportes y estadísticas del sistema</li>
                                    <li>Información de propietarios vinculados</li>
                                </ul>
                            </div>

                            <!-- Información de Contratos Relacionados -->
                            @if (ViewBag.TieneContratosActivos == true)
                            {
                                <div class="alert alert-danger">
                                    <h6>
                                        <i class="fas fa-ban"></i> NO SE PUEDE ELIMINAR
                                    </h6>
                                    <p class="mb-0">
                                        Este inmueble tiene contratos activos asociados. 
                                        Debe cancelar o finalizar todos los contratos antes de poder eliminar el inmueble.
                                    </p>
                                </div>
                            }
                            else if (ViewBag.TieneContratosHistoricos == true)
                            {
                                <div class="alert alert-info">
                                    <h6>
                                        <i class="fas fa-history"></i> Contratos Históricos
                                    </h6>
                                    <p class="mb-0">
                                        Este inmueble tiene contratos históricos. La eliminación afectará los reportes históricos.
                                    </p>
                                </div>
                            }
                            else
                            {
                                <div class="alert alert-success">
                                    <h6>
                                        <i class="fas fa-check-circle"></i> Sin Contratos Activos
                                    </h6>
                                    <p class="mb-0">
                                        No se detectaron contratos activos asociados a este inmueble.
                                    </p>
                                </div>
                            }
                        </div>
                    </div>

                    <!-- Formulario de Eliminación -->
                    <form asp-action="Delete" class="mt-4">
                        <input type="hidden" asp-for="Id" />
                        
                        @if (ViewBag.TieneContratosActivos == true)
                        {
                            <div class="d-grid gap-2">
                                <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-primary btn-lg">
                                    <i class="fas fa-arrow-left"></i> Volver al Detalle
                                </a>
                            </div>
                        }
                        else
                        {
                            <div class="row">
                                <div class="col-md-6">
                                    <div class="form-group mb-3">
                                        <label for="confirmacionTexto" class="form-label fw-bold">
                                            Escriba "ELIMINAR" para confirmar:
                                        </label>
                                        <input type="text" class="form-control" id="confirmacionTexto" 
                                               placeholder="Escriba ELIMINAR aquí..." 
                                               oninput="validarConfirmacion()">
                                        <div class="form-text">
                                            Esta medida de seguridad evita eliminaciones accidentales.
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="d-grid gap-2 h-100">
                                        <button type="submit" class="btn btn-danger btn-lg" id="btnEliminar" disabled>
                                            <i class="fas fa-trash"></i> ELIMINAR DEFINITIVAMENTE
                                        </button>
                                        <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-secondary">
                                            <i class="fas fa-times"></i> Cancelar
                                        </a>
                                    </div>
                                </div>
                            </div>
                        }
                    </form>
                </div>
            </div>

            <!-- Información Adicional -->
            <div class="card mt-4">
                <div class="card-header bg-info text-white">
                    <h5 class="card-title mb-0">
                        <i class="fas fa-lightbulb"></i> Alternativas Recomendadas
                    </h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6">
                            <div class="card border-success h-100">
                                <div class="card-body text-center">
                                    <i class="fas fa-ban fa-2x text-success mb-3"></i>
                                    <h6>Marcar como No Disponible</h6>
                                    <p class="small text-muted">
                                        En lugar de eliminar, puede marcar el inmueble como no disponible.
                                    </p>
                                    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-success btn-sm">
                                        <i class="fas fa-edit"></i> Editar Estado
                                    </a>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="card border-warning h-100">
                                <div class="card-body text-center">
                                    <i class="fas fa-archive fa-2x text-warning mb-3"></i>
                                    <h6>Archivar Inmueble</h6>
                                    <p class="small text-muted">
                                        Archive el inmueble para mantener el historial pero ocultarlo de las listas activas.
                                    </p>
                                    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-warning btn-sm">
                                        <i class="fas fa-archive"></i> Archivar
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function validarConfirmacion() {
            const input = document.getElementById('confirmacionTexto');
            const boton = document.getElementById('btnEliminar');
            const textoConfirmacion = 'ELIMINAR';
            
            if (input.value.toUpperCase() === textoConfirmacion) {
                boton.disabled = false;
                input.classList.remove('is-invalid');
                input.classList.add('is-valid');
            } else {
                boton.disabled = true;
                input.classList.remove('is-valid');
                input.classList.add('is-invalid');
            }
        }

        // Confirmación adicional al hacer clic en el botón
        document.getElementById('btnEliminar')?.addEventListener('click', function(e) {
            if (!confirm('¿ESTÁ ABSOLUTAMENTE SEGURO?\n\nEsta acción eliminará permanentemente el inmueble y toda su información asociada.')) {
                e.preventDefault();
            }
        });
    </script>
}