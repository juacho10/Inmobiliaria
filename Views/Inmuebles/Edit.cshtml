@model Inmobiliaria.Models.Inmueble

@{
    ViewData["Title"] = "Editar Inmueble";
}

<div class="container">
    <div class="row">
        <div class="col-12">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a asp-action="Index">Inmuebles</a></li>
                    <li class="breadcrumb-item"><a asp-action="Details" asp-route-id="@Model.Id">@Model.Direccion</a></li>
                    <li class="breadcrumb-item active">Editar</li>
                </ol>
            </nav>
        </div>
    </div>

    <div class="row">
        <div class="col-md-8">
            <div class="card">
                <div class="card-header bg-warning text-white">
                    <h2 class="card-title mb-0">
                        <i class="fas fa-edit"></i> Editar Inmueble #@Model.Id
                    </h2>
                </div>
                <div class="card-body">
                    <form asp-action="Edit" id="inmuebleForm">
                        <input type="hidden" asp-for="Id" />
                        <input type="hidden" asp-for="FechaCreacion" />
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                        <div class="form-group mb-3">
                            <label asp-for="Direccion" class="form-label fw-bold">Dirección *</label>
                            <input asp-for="Direccion" class="form-control" />
                            <span asp-validation-for="Direccion" class="text-danger small"></span>
                        </div>

                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group mb-3">
                                    <label asp-for="PropietarioId" class="form-label fw-bold">Propietario *</label>
                                    <select asp-for="PropietarioId" class="form-select" id="propietarioSelect">
                                        @if (Model.Propietario != null)
                                        {
                                            <option value="@Model.Propietario.Id" selected>
                                                @Model.Propietario.NombreCompleto - DNI @Model.Propietario.Dni
                                            </option>
                                        }
                                    </select>
                                    <span asp-validation-for="PropietarioId" class="text-danger small"></span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group mb-3">
                                    <label asp-for="Tipo" class="form-label fw-bold">Tipo *</label>
                                    <select asp-for="Tipo" class="form-select">
                                        <option value="Casa">Casa</option>
                                        <option value="Departamento">Departamento</option>
                                        <option value="Local">Local Comercial</option>
                                        <option value="Oficina">Oficina</option>
                                        <option value="Depósito">Depósito</option>
                                        <option value="PH">PH</option>
                                    </select>
                                    <span asp-validation-for="Tipo" class="text-danger small"></span>
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-4">
                                <div class="form-group mb-3">
                                    <label asp-for="Uso" class="form-label fw-bold">Uso *</label>
                                    <select asp-for="Uso" class="form-select">
                                        <option value="Residencial">Residencial</option>
                                        <option value="Comercial">Comercial</option>
                                        <option value="Industrial">Industrial</option>
                                        <option value="Mixto">Mixto</option>
                                    </select>
                                    <span asp-validation-for="Uso" class="text-danger small"></span>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="form-group mb-3">
                                    <label asp-for="Ambientes" class="form-label fw-bold">Ambientes *</label>
                                    <input asp-for="Ambientes" type="number" class="form-control" min="1" max="50" />
                                    <span asp-validation-for="Ambientes" class="text-danger small"></span>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="form-group mb-3">
                                    <label asp-for="Precio" class="form-label fw-bold">Precio Mensual *</label>
                                    <div class="input-group">
                                        <span class="input-group-text">$</span>
                                        <input asp-for="Precio" type="number" class="form-control" step="0.01" min="1" />
                                    </div>
                                    <span asp-validation-for="Precio" class="text-danger small"></span>
                                </div>
                            </div>
                        </div>

                        <div class="form-group mb-3">
                            <label asp-for="Coordenadas" class="form-label fw-bold">Coordenadas (Opcional)</label>
                            <input asp-for="Coordenadas" class="form-control" />
                            <span asp-validation-for="Coordenadas" class="text-danger small"></span>
                        </div>

                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-check form-switch mb-2">
                                    <input asp-for="Disponible" class="form-check-input" type="checkbox" />
                                    <label asp-for="Disponible" class="form-check-label fw-bold">Disponible</label>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-check form-switch mb-2">
                                    <input asp-for="Activo" class="form-check-input" type="checkbox" />
                                    <label asp-for="Activo" class="form-check-label fw-bold">Activo</label>
                                </div>
                            </div>
                        </div>

                        <div class="d-grid gap-2 d-md-flex justify-content-md-end mt-4">
                            <button type="submit" class="btn btn-warning btn-lg">
                                <i class="fas fa-save"></i> Guardar
                            </button>
                            <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-secondary btn-lg">Cancelar</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        $(function () {
            initSelect2(
                '#propietarioSelect',
                '@Url.Action("BuscarPropietarios", "Inmuebles")',
                'Buscar propietario por nombre o DNI...'
            );
        });
    </script>
}